---
// ブログ一覧（/lptest/blog/）。公開ビルドでは draft を除外、dev では表示。
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));
---
<Layout title="ブログ — lptest" description="lptest のブログ記事一覧。">
  <main class="wrap">
    <h1>ブログ</h1>
    {posts.length === 0 && <p>まだ記事はありません。</p>}
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a href={`${base}/blog/${p.slug}/`}>{p.data.title ?? p.slug}</a>
          {p.data.description && <span class="desc">{p.data.description}</span>}
        </li>
      ))}
    </ul>
    <p><a href={`${base}/`}>← トップへ</a></p>
  </main>

  <style>
    .wrap { max-width: 720px; margin: 0 auto; padding: 40px 20px; line-height: 1.7;
      font-family: system-ui, -apple-system, "Segoe UI", "Meiryo", sans-serif; }
    h1 { font-size: 26px; }
    .post-list { list-style: none; padding: 0; display: grid; gap: 14px; }
    .post-list li { border-top: 1px solid #eef0f3; padding-top: 14px; }
    .post-list a { color: #2563eb; text-decoration: none; font-weight: 700; }
    .post-list .desc { display: block; color: #6b7280; font-size: 14px; margin-top: 4px; }
  </style>
</Layout>
