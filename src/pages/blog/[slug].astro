---
// ブログ記事ページ（/lptest/blog/{slug}/）。1 記事＝1 ページ。
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // 公開ビルドでは draft を除外（プレビュー用 preview-draft-*.md も公開されない）。
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { post } = Astro.props;
const { Content } = await post.render();
const title = post.data.title ?? post.slug;
---
<Layout title={`${title} — lptest`} description={post.data.description ?? post.data.excerpt ?? ''}>
  <main class="wrap">
    <article>
      <h1>{title}</h1>
      <Content />
    </article>
    <p class="back"><a href={`${base}/blog/`}>← ブログ一覧へ</a></p>
  </main>

  <style>
    .wrap { max-width: 720px; margin: 0 auto; padding: 40px 20px; line-height: 1.8;
      font-family: system-ui, -apple-system, "Segoe UI", "Meiryo", sans-serif; color: #111827; }
    h1 { font-size: 28px; line-height: 1.3; }
    article :global(h2) { font-size: 22px; margin-top: 1.6em; }
    article :global(a) { color: #2563eb; }
    .back { margin-top: 40px; }
    .back a { color: #2563eb; text-decoration: none; }
  </style>
</Layout>
