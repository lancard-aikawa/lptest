---
// LP トップ。旧 index.html の内容をそのまま移植（見た目・GA4・CTA イベントは不変）。
// スタイルは元が <head> 直下のグローバル指定だったため is:global で同等に再現。
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="lptest — ランディングページ" description="lptest のランディングページ。">
  <header class="hero">
    <div class="wrap">
      <h1>lptest へようこそ</h1>
      <p>これは GA4 計測と更新サイクルの検証用ランディングページです。</p>
      <button type="button" class="cta" id="cta">お問い合わせはこちら</button>
      <p class="subnav"><a class="bloglink" href={`${base}/blog/`} data-blog-nav="hero">ブログを読む →</a></p>
    </div>
  </header>

  <main>
    <section>
      <div class="wrap">
        <h2>特徴</h2>
        <ul class="points">
          <li>静的 HTML 1 枚（GitHub Pages で配信）</li>
          <li>GA4 で流入・コンバージョンを計測</li>
          <li>解析 → 改善示唆 → 更新のループを回す</li>
        </ul>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <p class="footnav"><a href={`${base}/blog/`} data-blog-nav="footer">ブログ</a></p>
      © lptest
    </div>
  </footer>

  <style is:global>
    :root { --accent: #2563eb; --ink: #111827; --muted: #6b7280; --bg: #ffffff; }
    * { box-sizing: border-box; }
    body {
      margin: 0; font-family: system-ui, -apple-system, "Segoe UI", "Hiragino Kaku Gothic ProN", "Meiryo", sans-serif;
      color: var(--ink); background: var(--bg); line-height: 1.7;
    }
    .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
    header.hero { padding: 88px 0 64px; text-align: center; }
    .hero h1 { font-size: clamp(28px, 6vw, 44px); margin: 0 0 16px; letter-spacing: .02em; }
    .hero p { font-size: clamp(16px, 3vw, 19px); color: var(--muted); margin: 0 0 32px; }
    .cta {
      display: inline-block; background: var(--accent); color: #fff; text-decoration: none;
      font-weight: 700; padding: 16px 32px; border-radius: 10px; border: 0; cursor: pointer;
      font-size: 17px; transition: transform .05s ease, opacity .15s ease;
    }
    .cta:hover { opacity: .92; }
    .cta:active { transform: translateY(1px); }
    section { padding: 48px 0; border-top: 1px solid #eef0f3; }
    section h2 { font-size: 22px; margin: 0 0 16px; }
    ul.points { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
    ul.points li { padding-left: 28px; position: relative; }
    ul.points li::before { content: "✓"; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
    footer { padding: 40px 0 64px; text-align: center; color: var(--muted); font-size: 14px; }
    .subnav { margin: 0; }
    .subnav .bloglink { color: var(--accent); text-decoration: none; font-weight: 600; font-size: 15px; }
    .subnav .bloglink:hover { text-decoration: underline; }
    footer .footnav { margin: 0 0 10px; }
    footer .footnav a { color: var(--accent); text-decoration: none; }
    footer .footnav a:hover { text-decoration: underline; }
  </style>

  <script is:inline>
    // CTA クリックを GA4 のコンバージョン候補イベントとして送信。
    // lp-manager の cv_event_name にはこの "generate_lead" を設定する想定。
    document.getElementById('cta').addEventListener('click', function () {
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', { source: 'hero_cta' });
      }
      // TODO: 実際の問い合わせ先（フォーム/メール等）へ差し替え
      alert('お問い合わせありがとうございます（デモ）');
    });

    // LP → ブログ導線のクリックを GA4 の select_content で計測（hero / footer を item_id で区別）。
    Array.prototype.forEach.call(document.querySelectorAll('[data-blog-nav]'), function (el) {
      el.addEventListener('click', function () {
        if (typeof gtag === 'function') {
          gtag('event', 'select_content', { content_type: 'blog', item_id: el.getAttribute('data-blog-nav') });
        }
      });
    });
  </script>
</Layout>
